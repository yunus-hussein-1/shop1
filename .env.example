# انسخ هاد الملف باسم .env واملأ القيم الحقيقية محلياً أو بلوحة تحكم الاستضافة
# لا ترفع ملف .env الحقيقي أبداً لـ GitHub (محمي أصلاً ضمن .gitignore)

SECRET_KEY=generate-a-long-random-value-here
DATABASE_URL=sqlite:///shayeb.db
ADMIN_EMAIL=your-real-admin-email@example.com
SUPPORT_EMAIL=support@shayebshop.com

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=SHAYEB SHOP <no-reply@shayebshop.com>

FORCE_HTTPS=0
